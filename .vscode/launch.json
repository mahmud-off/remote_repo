{
    "version": "2.0.0",
    "configurations": [
        {
            // Запуск уязвимой версии (Windows/MSVC): сборка vulnerable/
            "name": "textzip: vulnerable (file input)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/vulnerable/Release/textzip.exe",
            "args": ["samples/sample.txt", "out_vulnerable.z"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build vulnerable (Release)"
        },
        {
            "name": "textzip: vulnerable (stdin)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/vulnerable/Release/textzip.exe",
            "args": ["-", "out_stdin.z"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build vulnerable (Release)"
        },
        {
            // Запуск исправленной версии (Windows/MSVC): сборка fixed/
            "name": "textzip: fixed (file input)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/fixed/Release/textzip.exe",
            "args": ["samples/sample.txt", "out_fixed.z"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build fixed (Release)"
        },
        {
            "name": "textzip: fixed (stdin)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/fixed/Release/textzip.exe",
            "args": ["-", "out_fixed_stdin.z"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build fixed (Release)"
        }
    ]
}
