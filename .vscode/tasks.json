{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "CMake: configure vulnerable",
            "type": "shell",
            "command": "cmake -S vulnerable -B build/vulnerable -G \"Visual Studio 17 2022\" -A x64",
            "problemMatcher": []
        },
        {
            "label": "CMake: build vulnerable",
            "type": "shell",
            "command": "cmake --build build/vulnerable --config Release",
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake: configure fixed",
            "type": "shell",
            "command": "cmake -S fixed -B build/fixed -G \"Visual Studio 17 2022\" -A x64",
            "problemMatcher": []
        },
        {
            "label": "CMake: build fixed",
            "type": "shell",
            "command": "cmake --build build/fixed --config Release",
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "SAST (vulnerable): cppcheck",
            "type": "shell",
            "command": "cppcheck --force --enable=all --std=c++17 --language=c++ --template=gcc --suppress=missingIncludeSystem --suppress=ConfigurationNotChecked -I vulnerable\\third_party\\zlib-1.2.11 vulnerable\\src 2>&1 | Tee-Object -FilePath reports\\vulnerable\\cppcheck-local.txt",
            "problemMatcher": []
        },
        {
            "label": "SAST (vulnerable): MSVC /analyze",
            "type": "shell",
            "command": "cl /nologo /std:c++17 /EHsc /c /I vulnerable\\third_party\\zlib-1.2.11 /D_CRT_SECURE_NO_WARNINGS /analyze /analyze:log reports\\vulnerable\\msvc-sast.xml vulnerable\\src\\main.cpp 2>&1 | Tee-Object -FilePath reports\\vulnerable\\msvc-sast-console.txt",
            "problemMatcher": []
        },
        {
            "label": "SAST (vulnerable): flawfinder",
            "type": "shell",
            "command": "python -m flawfinder --minlevel=1 vulnerable\\src 2>&1 | Tee-Object -FilePath reports\\vulnerable\\flawfinder-local.txt",
            "problemMatcher": []
        },
        {
            "label": "SAST (fixed): cppcheck",
            "type": "shell",
            "command": "cppcheck --force --enable=all --std=c++17 --language=c++ --template=gcc --suppress=missingIncludeSystem --suppress=ConfigurationNotChecked -I fixed\\third_party\\zlib-1.3.1 fixed\\src 2>&1 | Tee-Object -FilePath reports\\fixed\\cppcheck-local.txt",
            "problemMatcher": []
        },
        {
            "label": "SAST (fixed): MSVC /analyze",
            "type": "shell",
            "command": "cl /nologo /std:c++17 /EHsc /c /I fixed\\third_party\\zlib-1.3.1 /D_CRT_SECURE_NO_WARNINGS /analyze /analyze:log reports\\fixed\\msvc-sast.xml fixed\\src\\main.cpp 2>&1 | Tee-Object -FilePath reports\\fixed\\msvc-sast-console.txt",
            "problemMatcher": []
        },
        {
            "label": "SAST (fixed): flawfinder",
            "type": "shell",
            "command": "python -m flawfinder --minlevel=1 fixed\\src 2>&1 | Tee-Object -FilePath reports\\fixed\\flawfinder-local.txt",
            "problemMatcher": []
        }
    ]
}
